# Скопируй в .env и заполни: cp .env.example .env
# Файл .env в git не попадает - он в .gitignore.

# --- Обязательно ---
# Токен от @BotFather, команда /newbot
AVITO_BOT_TOKEN=

# --- Настоятельно рекомендуется ---
# Твой Telegram ID, чтобы ботом не пользовались посторонние.
# Узнать: запусти бота и отправь /myid. Несколько ID - через запятую.
AVITO_OWNER_ID=

# Ключ для консультанта по сделкам. Бесплатно на console.groq.com.
# Без него монитор работает, а на вопросы бот отвечать не будет.
GROQ_API_KEY=

# --- Обход блокировки Telegram ---
# Нужно, если с сервера не открывается api.telegram.org (проверка:
# curl -4 --max-time 20 https://api.telegram.org - если тишина, значит режут).
# На запросы к Авито не влияет: он читается напрямую, с российского адреса.
# Заполнять НЕ оба сразу, а любой один.
#
# Вариант 1 - прокси. Токен через него не утекает: соединение с Telegram
# шифруется от начала до конца, прокси видит только адрес.
TELEGRAM_PROXY=
#
# Вариант 2 - своё зеркало Bot API, например на Cloudflare Workers.
# Адрес без токена на конце: https://xxxxx.workers.dev
TELEGRAM_BASE_URL=

# Адрес api.telegram.org по IPv4. Нужен, если на сервере IPv6 настроен,
# но не работает: имя разрешается в адрес 2001:... и бот виснет на старте.
# Узнать рабочий: getent ahostsv4 api.telegram.org
TELEGRAM_IPV4=

# --- Запуск монитора без кнопок ---
# Пока опрос Telegram нестабилен, кнопка «🟢 Включить» может не дойти до
# бота. Эти две строки делают то же самое при старте контейнера.
# AVITO_ENABLED=1 - включить слежку сразу.
# AVITO_OWNER_CHAT - куда слать находки. Для личной переписки это тот же
# номер, что и AVITO_OWNER_ID выше.
AVITO_ENABLED=
AVITO_OWNER_CHAT=

# --- Настройки монитора (можно не трогать) ---
AVITO_MAX_PRICE=5000
AVITO_REGION=krasnodar

# --- Скорость обхода: от неё зависит и блокировка, и счёт за трафик ---
# Умолчания подобраны по опыту 06.08.2026: три обращения за утро - выдача
# приходила, сорок за час - капча на весь день. Прежние настройки давали
# около 180 обращений в час круглосуточно, то есть вчетверо больше того,
# чем блокировка была заработана.
#
# Одна страница выдачи весит 0,4-1 МБ. При оплате прокси за трафик это
# прямо переводится в деньги: 100 запросов в сутки - гигабайта хватит на
# две недели, 250 - на шесть дней.
#
# Слов в списке 19. За круг берётся горсть, список крутится по кольцу.
AVITO_QUERIES_PER_CYCLE=3
AVITO_REQ_DELAY_MIN=45
AVITO_REQ_DELAY_MAX=90
AVITO_CYCLE_PAUSE=900

# Прокси для Авито, если адрес сервера под блокировкой. Годятся мобильные
# и резидентские российские; датацентровые режут так же, как сам сервер.
# http://user:pass@host:port или socks5://user:pass@host:port
AVITO_PROXY=
