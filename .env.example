# Скопируй в .env и заполни: cp .env.example .env
# Файл .env в git не попадает - он в .gitignore.

# --- Обязательно ---
# Токен от @BotFather, команда /newbot
AVITO_BOT_TOKEN=

# --- Настоятельно рекомендуется ---
# Твой Telegram ID, чтобы ботом не пользовались посторонние.
# Узнать: запусти бота и отправь /myid. Несколько ID - через запятую.
AVITO_OWNER_ID=

# Ключ для консультанта по сделкам. Бесплатно на console.groq.com.
# Без него монитор работает, а на вопросы бот отвечать не будет.
GROQ_API_KEY=

# --- Обход блокировки Telegram ---
# Нужно, если с сервера не открывается api.telegram.org (проверка:
# curl -4 --max-time 20 https://api.telegram.org - если тишина, значит режут).
# На запросы к Авито не влияет: он читается напрямую, с российского адреса.
# Заполнять НЕ оба сразу, а любой один.
#
# Вариант 1 - прокси. Токен через него не утекает: соединение с Telegram
# шифруется от начала до конца, прокси видит только адрес.
TELEGRAM_PROXY=
#
# Вариант 2 - своё зеркало Bot API, например на Cloudflare Workers.
# Адрес без токена на конце: https://xxxxx.workers.dev
TELEGRAM_BASE_URL=

# --- Настройки монитора (можно не трогать) ---
AVITO_MAX_PRICE=5000
AVITO_REGION=krasnodar
# Прокси, если IP словил блокировку: http://user:pass@host:port
AVITO_PROXY=
