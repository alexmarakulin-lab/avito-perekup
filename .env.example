# Скопируй в .env и заполни: cp .env.example .env
# Файл .env в git не попадает - он в .gitignore.

# --- Обязательно ---
# Токен от @BotFather, команда /newbot
AVITO_BOT_TOKEN=

# --- Настоятельно рекомендуется ---
# Твой Telegram ID, чтобы ботом не пользовались посторонние.
# Узнать: запусти бота и отправь /myid. Несколько ID - через запятую.
AVITO_OWNER_ID=

# Ключ для консультанта по сделкам. Бесплатно на console.groq.com.
# Без него монитор работает, а на вопросы бот отвечать не будет.
GROQ_API_KEY=

# --- Обход блокировки Telegram ---
# Нужно, если с сервера не открывается api.telegram.org (проверка:
# curl -4 --max-time 20 https://api.telegram.org - если тишина, значит режут).
# На запросы к Авито не влияет: он читается напрямую, с российского адреса.
# Заполнять НЕ оба сразу, а любой один.
#
# Вариант 1 - прокси. Токен через него не утекает: соединение с Telegram
# шифруется от начала до конца, прокси видит только адрес.
TELEGRAM_PROXY=
#
# Вариант 2 - своё зеркало Bot API, например на Cloudflare Workers.
# Адрес без токена на конце: https://xxxxx.workers.dev
TELEGRAM_BASE_URL=

# Адрес api.telegram.org по IPv4. Нужен, если на сервере IPv6 настроен,
# но не работает: имя разрешается в адрес 2001:... и бот виснет на старте.
# Узнать рабочий: getent ahostsv4 api.telegram.org
TELEGRAM_IPV4=

# --- Запуск монитора без кнопок ---
# Пока опрос Telegram нестабилен, кнопка «🟢 Включить» может не дойти до
# бота. Эти две строки делают то же самое при старте контейнера.
# AVITO_ENABLED=1 - включить слежку сразу.
# AVITO_OWNER_CHAT - куда слать находки. Для личной переписки это тот же
# номер, что и AVITO_OWNER_ID выше.
AVITO_ENABLED=
AVITO_OWNER_CHAT=

# --- Настройки монитора (можно не трогать) ---
AVITO_MAX_PRICE=5000
AVITO_REGION=krasnodar

# Насколько лот должен быть дешевле медианы рынка, чтобы бот разбудил.
# 0.5 - вдвое дешевле; это единственный порог, мягкого больше нет.
# Замер 27.08.2026: на 0.6 приходило 34 сообщения за четверть часа и
# настоящие находки в них тонули. Поднимать до 0.7-0.8 значит вернуть тот
# поток; опускать до 0.4 - будить в лучшем случае раз в неделю.
AVITO_DEAL_RATIO=0.5

# --- Скорость обхода: от неё зависит и блокировка, и счёт за трафик ---
# Умолчания подобраны по опыту 06.08.2026: три обращения за утро - выдача
# приходила, сорок за час - капча на весь день. Прежние настройки давали
# около 180 обращений в час круглосуточно, то есть вчетверо больше того,
# чем блокировка была заработана.
#
# Одна страница выдачи весит 0,4-1 МБ. При оплате прокси за трафик это
# прямо переводится в деньги: 100 запросов в сутки - гигабайта хватит на
# две недели, 250 - на шесть дней.
#
# Слов в списке 51: 39 на Авито, 12 на Wildberries. За круг берётся горсть,
# список крутится по кольцу - значит, полный обход занимает не один круг.
# При горсти 3 и паузе 900 с это 17 кругов, больше пяти часов: столько в
# худшем случае новое объявление ждёт, пока бот до него доберётся. Горсть 5
# и пауза 600 с сокращают обход до трёх часов ценой вдвое большего числа
# обращений - примерно 19 в час против 10.
AVITO_QUERIES_PER_CYCLE=3
AVITO_REQ_DELAY_MIN=45
AVITO_REQ_DELAY_MAX=90
AVITO_CYCLE_PAUSE=900

# --- Канал с находками ---
# Куда, кроме личной переписки, выкладывать находки. Пусто - канала нет.
# Годится и @имя публичного канала, и номер закрытого (начинается на -100).
# Бота нужно добавить в канал администратором с правом публикации.
#
# Канал отстаёт от владельца на AVITO_CHANNEL_DELAY секунд, и это главное:
# без задержки подписчики забирали бы лоты раньше того, кто их собрал.
# Полчаса хватает, чтобы позвонить и договориться.
#
# Порог у канала свой и мягче: владельцу шлётся только то, ради чего стоит
# ехать (вдвое дешевле рынка), а такого единицы в неделю - канал стоял бы
# пустым. Читателю интересен любой стоящий лот, он покупает себе.
AVITO_CHANNEL_CHAT=
AVITO_CHANNEL_DELAY=1800
AVITO_CHANNEL_RATIO=0.7

# Прокси для Авито. Скорее всего НЕ нужен: 12.08.2026 выяснилось, что дело
# было не в адресе. С того же самого домашнего интернета, где бот получал
# капчу, настоящий браузер открыл выдачу без единой заминки.
# http://user:pass@host:port или socks5://user:pass@host:port
AVITO_PROXY=

# --- Как бот добывает страницы Авито ---
# browser - настоящим браузером (умолчание и единственное, что проходит).
# http    - прежними запросами; оставлено на случай, если защита подобреет.
AVITO_FETCH=
#
# Прятать окно браузера нельзя: скрытый режим Авито распознаёт. Проверено
# 12.08.2026 на трёх вариантах подряд - все получили «Доступ ограничен».
# Окно можно свернуть, свёрнутое считается видимым.
AVITO_BROWSER_HEADLESS=
#
# Какой браузер запускать. chrome - установленный на компьютере. Встроенный
# в Playwright Chromium на домашней машине не стартует: Windows жалуется на
# side-by-side, ему не хватает системной библиотеки.
AVITO_BROWSER_CHANNEL=
#
# Папка профиля браузера. В ней живут печенья Авито, и она обязана
# переживать перезапуски: на чистом профиле каждый запуск начинается с
# капчи. По умолчанию browser_profile рядом с программой.
AVITO_BROWSER_PROFILE=

# ВАЖНО: монитор должен работать только в одном месте - или дома, или на
# сервере. Два разом это вдвое больше обращений к Авито (прямая дорога к
# капче) и два опроса Telegram, из-за чего сообщения начинают теряться.
